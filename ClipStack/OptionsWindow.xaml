<Window x:Class="ClipStack.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipStack Seçenekleri"
        Icon="Assets/ClipStack.ico"
        Width="560" Height="620" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <!-- Renkler temadan (Themes\Dark.xaml / Light.xaml), kontrol şablonları Themes\Controls.xaml'den gelir. -->
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="80" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,16,3" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

            <!-- ============ GENEL ============ -->
            <TabItem x:Name="GeneralTab" Header="Genel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">

                        <TextBlock Text="Geçmiş" Style="{StaticResource Section}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Kaydedilecek en fazla kopya sayısı:" VerticalAlignment="Center" Width="250" />
                            <TextBox x:Name="MaxHistoryBox" Style="{StaticResource Number}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                                   Text="Sınır aşılınca en uzun süredir kullanılmayan kayıt silinir. Sabitlenen kayıtlar bu sayıya dahil değildir. (10 – 100.000)" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bunlardan en fazla kaçı görsel olabilir:" VerticalAlignment="Center" Width="250" />
                            <TextBox x:Name="MaxImagesBox" Style="{StaticResource Number}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                                   Text="Görseller metne göre çok yer kaplar; sınır aşılınca en eski görsel silinir. (1 – 1.000)" />

                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ExpireCheck" Content="Kayıtları şu süre sonra sil:"
                                      VerticalAlignment="Center" Width="250"
                                      Checked="ExpireCheck_Changed" Unchecked="ExpireCheck_Changed" />
                            <TextBox x:Name="ExpireDaysBox" Style="{StaticResource Number}" />
                            <TextBlock Text="gün" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                                   Text="Süre, kaydın son kopyalandığı veya yapıştırıldığı andan itibaren sayılır. Sabitlenen kayıtlar asla silinmez. (1 – 3650)" />

                        <TextBlock Text="Görünüm" Style="{StaticResource Section}" />
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Tema:" VerticalAlignment="Center" Margin="0,4" />
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Windows'a uy" Margin="0,4,14,4" />
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Açık" Margin="0,4,14,4" />
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Koyu" Margin="0,4,14,4" />
                            </WrapPanel>
                            <TextBlock Grid.Row="1" Text="Geçmiş penceresi:" VerticalAlignment="Center" Margin="0,4" />
                            <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <RadioButton x:Name="PlaceCursor" GroupName="Place" Content="İmlecin yanında" Margin="0,4,14,4" />
                                <RadioButton x:Name="PlaceRemember" GroupName="Place" Content="Son konumunda" Margin="0,4,14,4" />
                                <RadioButton x:Name="PlaceCenter" GroupName="Place" Content="Ekranın ortasında" Margin="0,4,14,4" />
                            </WrapPanel>
                        </Grid>

                        <TextBlock Text="Sistem" Style="{StaticResource Section}" />
                        <CheckBox x:Name="StartupCheck" Content="Windows ile başlat" />
                        <TextBlock x:Name="StartupPathText" Style="{StaticResource Hint}" Margin="20,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ KISAYOL VE GİZLİLİK ============ -->
            <TabItem x:Name="HotkeyTab" Header="Kısayol ve Gizlilik">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Geçmişi açan kısayol" Style="{StaticResource Section}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HotkeyBox" Width="200" Padding="4,3" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False" Cursor="Arrow"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                            <Button Content="Varsayılan" Margin="8,0,0,0" Click="HotkeyDefault_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                                   Text="Kutuya tıklayıp yeni tuş birleşimine bas. Ctrl veya Alt içermeli (ör. Ctrl+Alt+V, Ctrl+Shift+Boşluk)." />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Kaydedilmeyecek uygulamalar" Style="{StaticResource Section}" />

                    <TextBox Grid.Row="2" x:Name="ExcludedAppsBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" Padding="4" MinHeight="90"
                             FontFamily="Consolas" />

                    <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Her satıra bir süreç adı (ör. KeePass veya chrome.exe). Bu uygulamalardan kopyalananlar geçmişe alınmaz. Parola yöneticilerinin çoğu ayrıca kendini zaten gizler." />

                    <StackPanel Grid.Row="4" Margin="0,14,0,0">
                        <TextBlock Text="İçerik kontrolü" Style="{StaticResource Section}" />
                        <CheckBox x:Name="SkipSecretsCheck" Content="Anahtar ve token içeren metinleri kaydetme (önerilir)" />
                        <TextBlock Style="{StaticResource Hint}" Margin="20,2,0,8"
                                   Text="GitHub/GitLab/Slack/npm token'ları, AWS ve Google API anahtarları, JWT, özel anahtar (PEM) blokları vb." />
                        <CheckBox x:Name="SkipPasswordsCheck" Content="Parolaya benzeyen tek parça metinleri kaydetme" />
                        <TextBlock Style="{StaticResource Hint}" Margin="20,2,0,8"
                                   Text="Tarayıcının parola yöneticisinden kopyalanan parolaları yakalar (boşluksuz, 8–64 karakter, harf/rakam/simge karışık). Kod parçalarını da yanlışlıkla atlayabilir." />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="🔒 Geçmiş diskte şifreli saklanır (SQLCipher). Anahtar Windows hesabınıza bağlıdır; dosyayı başka kullanıcı veya bilgisayar açamaz. Hassas bir işlem öncesi tepsi menüsünden &quot;Kaydı duraklat&quot; da kullanılabilir." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ İSTATİSTİKLER ============ -->
            <TabItem x:Name="StatsTab" Header="İstatistikler">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition Height="10" />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource StatLabel}" Text="Sayım başlangıcı:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatSince" />
                        <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="Toplam kopyalama:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatCopies" />
                        <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="Geçmişten yapıştırma:" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatPastes" />
                        <TextBlock Grid.Row="3" Style="{StaticResource StatLabel}" Text="Bugün eklenen kayıt:" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatToday" />

                        <TextBlock Grid.Row="5" Style="{StaticResource StatLabel}" Text="Kayıtlı öğe:" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatItems" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Style="{StaticResource StatLabel}" Text="Metin / Görsel / Dosya:" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatKinds" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Style="{StaticResource StatLabel}" Text="Sabitlenmiş:" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatPinned" />
                        <TextBlock Grid.Row="8" Style="{StaticResource StatLabel}" Text="En eski kayıt:" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatOldest" />
                        <TextBlock Grid.Row="9" Style="{StaticResource StatLabel}" Text="Veritabanı boyutu:" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatSize" />
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="Yenile" Margin="0,0,6,6" Click="RefreshStats_Click" />
                        <Button Content="Sayaçları sıfırla" Margin="0,0,6,6" Click="ResetStats_Click" />
                        <Button Content="Veritabanını sıkıştır" Margin="0,0,6,6" Click="Compact_Click" />
                        <Button Content="Geçmişi temizle" Margin="0,0,6,6" Click="ClearHistory_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- ============ YEDEKLEME ============ -->
            <TabItem x:Name="BackupTab" Header="Yedekleme">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Elle yedek" Style="{StaticResource Section}" />
                        <WrapPanel>
                            <Button Content="Yedek al…" Margin="0,0,6,6" Click="Backup_Click" />
                            <Button Content="Yedekten geri yükle…" Margin="0,0,6,6" Click="Restore_Click" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,18"
                                   Text="Yedek; metin, görsel, dosya kayıtları ve sabitlemelerle birlikte tüm geçmişi tek bir .db dosyasına yazar. Şifreli yedek sadece bu Windows hesabında açılır; başka bilgisayara taşımak için şifresiz alın (dosyayı güvenli yerde tutun). Geri yükleme mevcut geçmişi silmez, yedekteki kayıtları ekler (aynı içerik iki kez eklenmez)." />

                        <TextBlock Text="Dışa aktar" Style="{StaticResource Section}" />
                        <Button Content="Metinleri .txt olarak dışa aktar…" HorizontalAlignment="Left" Click="ExportText_Click" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                                   Text="Tüm metin kayıtlarını tarih ve kaynak uygulamayla birlikte okunabilir (şifresiz) bir metin dosyasına yazar." />

                        <TextBlock Text="Otomatik yedek" Style="{StaticResource Section}" />
                        <CheckBox x:Name="AutoBackupCheck" Content="Günde bir kez otomatik yedek al" />
                        <TextBlock x:Name="AutoBackupInfo" Style="{StaticResource Hint}" Margin="20,4,0,8" />
                        <Button Content="Yedek klasörünü aç" HorizontalAlignment="Left" Click="OpenBackupFolder_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ HAKKINDA ============ -->
            <TabItem x:Name="AboutTab" Header="Hakkında">
                <StackPanel Margin="14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="Assets/ClipStack.ico" Width="48" Height="48" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ClipStack" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="AboutVersion" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Windows için hafif bir pano geçmişi yöneticisi. Kopyaladığın metin, görsel ve dosyaları saklar, kısayolla arayıp istediğin yere yeniden yapıştırmanı sağlar. Ditto'dan esinlenilmiştir." />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource StatLabel}" Text="Kısayol:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="AboutHotkey" />
                        <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="Çalışma ortamı:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="AboutRuntime" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="Veri klasörü:" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="AboutDataFolder" TextWrapping="Wrap" />
                    </Grid>

                    <Button Content="Veri klasörünü aç" HorizontalAlignment="Left" Click="OpenDataFolder_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Tamam" IsDefault="True" Margin="0,0,6,0" Click="Ok_Click" />
            <Button Content="İptal" IsCancel="True" Margin="0,0,6,0" Click="Cancel_Click" />
            <Button Content="Uygula" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
