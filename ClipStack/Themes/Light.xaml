<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Açık tema renkleri. Dark.xaml ile aynı anahtarlara sahip olmalı (testte karşılaştırılır). -->
    <SolidColorBrush x:Key="BgBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E9EDF5" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C9CDD6" />
    <SolidColorBrush x:Key="FgBrush" Color="#1F2128" />
    <SolidColorBrush x:Key="MutedBrush" Color="#62666F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B6FE0" />
    <SolidColorBrush x:Key="AccentFgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#E6EBF5" />
    <SolidColorBrush x:Key="WarnBrush" Color="#A35F00" />
    <SolidColorBrush x:Key="ThumbBackBrush" Color="#FFFFFF" />
</ResourceDictionary>
