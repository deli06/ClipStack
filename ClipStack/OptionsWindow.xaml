<Window x:Class="ClipStack.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClipStack"
        Title="{l:Loc Opt_Title}"
        Icon="Assets/ClipStack.ico"
        Width="580" Height="640" MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <!-- Renkler temadan (Themes\Dark.xaml / Light.xaml), kontrol şablonları Themes\Controls.xaml'den,
         metinler Resources\Strings*.resx'ten ({l:Loc Anahtar}) gelir. -->
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="80" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,16,3" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

            <!-- ============ GENEL ============ -->
            <TabItem x:Name="GeneralTab" Header="{l:Loc Tab_General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">

                        <TextBlock Text="{l:Loc Sec_History}" Style="{StaticResource Section}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Loc Lbl_MaxHistory}" VerticalAlignment="Center" Width="260" TextWrapping="Wrap" />
                            <TextBox x:Name="MaxHistoryBox" Style="{StaticResource Number}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" Text="{l:Loc Hint_MaxHistory}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Loc Lbl_MaxImages}" VerticalAlignment="Center" Width="260" TextWrapping="Wrap" />
                            <TextBox x:Name="MaxImagesBox" Style="{StaticResource Number}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" Text="{l:Loc Hint_MaxImages}" />

                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ExpireCheck" Content="{l:Loc Chk_Expire}"
                                      VerticalAlignment="Center" Width="260"
                                      Checked="ExpireCheck_Changed" Unchecked="ExpireCheck_Changed" />
                            <TextBox x:Name="ExpireDaysBox" Style="{StaticResource Number}" />
                            <TextBlock Text="{l:Loc Lbl_Days}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18" Text="{l:Loc Hint_Expire}" />

                        <TextBlock Text="{l:Loc Sec_Appearance}" Style="{StaticResource Section}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:Loc Lbl_Theme}" VerticalAlignment="Center" Margin="0,4" />
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="{l:Loc Theme_System}" Margin="0,4,14,4" />
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="{l:Loc Theme_Light}" Margin="0,4,14,4" />
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="{l:Loc Theme_Dark}" Margin="0,4,14,4" />
                            </WrapPanel>
                            <TextBlock Grid.Row="1" Text="{l:Loc Lbl_PopupPlacement}" VerticalAlignment="Center" Margin="0,4" />
                            <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <RadioButton x:Name="PlaceCursor" GroupName="Place" Content="{l:Loc Place_Cursor}" Margin="0,4,14,4" />
                                <RadioButton x:Name="PlaceRemember" GroupName="Place" Content="{l:Loc Place_Remember}" Margin="0,4,14,4" />
                                <RadioButton x:Name="PlaceCenter" GroupName="Place" Content="{l:Loc Place_Center}" Margin="0,4,14,4" />
                            </WrapPanel>
                            <TextBlock Grid.Row="2" Text="{l:Loc Lbl_Language}" VerticalAlignment="Center" Margin="0,4" />
                            <!-- Dil adları her dilde kendi adıyla yazılır (Türkçe arayüzde de "English"). -->
                            <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                <RadioButton x:Name="LangSystem" GroupName="Lang" Content="{l:Loc Lang_System}" Margin="0,4,14,4" />
                                <RadioButton x:Name="LangTurkish" GroupName="Lang" Content="Türkçe" Margin="0,4,14,4" />
                                <RadioButton x:Name="LangEnglish" GroupName="Lang" Content="English" Margin="0,4,14,4" />
                            </WrapPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,0,0,18" Text="{l:Loc Hint_Language}" />

                        <TextBlock Text="{l:Loc Sec_System}" Style="{StaticResource Section}" />
                        <CheckBox x:Name="StartupCheck" Content="{l:Loc Chk_Startup}" />
                        <TextBlock x:Name="StartupPathText" Style="{StaticResource Hint}" Margin="20,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ KISAYOL VE GİZLİLİK ============ -->
            <TabItem x:Name="HotkeyTab" Header="{l:Loc Tab_Hotkey}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{l:Loc Sec_Hotkey}" Style="{StaticResource Section}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HotkeyBox" Width="200" Padding="4,3" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False" Cursor="Arrow"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                            <Button Content="{l:Loc Btn_Default}" Margin="8,0,0,0" Click="HotkeyDefault_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18" Text="{l:Loc Hint_Hotkey}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{l:Loc Sec_ExcludedApps}" Style="{StaticResource Section}" />

                    <TextBox Grid.Row="2" x:Name="ExcludedAppsBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" Padding="4" MinHeight="90"
                             FontFamily="Consolas" />

                    <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{l:Loc Hint_ExcludedApps}" />

                    <StackPanel Grid.Row="4" Margin="0,14,0,0">
                        <TextBlock Text="{l:Loc Sec_ContentCheck}" Style="{StaticResource Section}" />
                        <CheckBox x:Name="SkipSecretsCheck" Content="{l:Loc Chk_SkipSecrets}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="20,2,0,8" Text="{l:Loc Hint_SkipSecrets}" />
                        <CheckBox x:Name="SkipPasswordsCheck" Content="{l:Loc Chk_SkipPasswords}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="20,2,0,8" Text="{l:Loc Hint_SkipPasswords}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Hint_Encryption}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ İSTATİSTİKLER ============ -->
            <TabItem x:Name="StatsTab" Header="{l:Loc Tab_Stats}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition Height="10" />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource StatLabel}" Text="{l:Loc Stat_Since}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatSince" />
                        <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="{l:Loc Stat_Copies}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatCopies" />
                        <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="{l:Loc Stat_Pastes}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatPastes" />
                        <TextBlock Grid.Row="3" Style="{StaticResource StatLabel}" Text="{l:Loc Stat_Today}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatToday" />

                        <TextBlock Grid.Row="5" Style="{StaticResource StatLabel}" Text="{l:Loc Stat_Items}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatItems" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Style="{StaticResource StatLabel}" Text="{l:Loc Stat_Kinds}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatKinds" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Style="{StaticResource StatLabel}" Text="{l:Loc Stat_Pinned}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatPinned" />
                        <TextBlock Grid.Row="8" Style="{StaticResource StatLabel}" Text="{l:Loc Stat_Oldest}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatOldest" />
                        <TextBlock Grid.Row="9" Style="{StaticResource StatLabel}" Text="{l:Loc Stat_Size}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="StatSize" />
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="{l:Loc Btn_Refresh}" Margin="0,0,6,6" Click="RefreshStats_Click" />
                        <Button Content="{l:Loc Btn_ResetStats}" Margin="0,0,6,6" Click="ResetStats_Click" />
                        <Button Content="{l:Loc Btn_Compact}" Margin="0,0,6,6" Click="Compact_Click" />
                        <Button Content="{l:Loc Btn_ClearHistory}" Margin="0,0,6,6" Click="ClearHistory_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- ============ YEDEKLEME ============ -->
            <TabItem x:Name="BackupTab" Header="{l:Loc Tab_Backup}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{l:Loc Sec_ManualBackup}" Style="{StaticResource Section}" />
                        <WrapPanel>
                            <Button Content="{l:Loc Btn_Backup}" Margin="0,0,6,6" Click="Backup_Click" />
                            <Button Content="{l:Loc Btn_Restore}" Margin="0,0,6,6" Click="Restore_Click" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,18" Text="{l:Loc Hint_Backup}" />

                        <TextBlock Text="{l:Loc Sec_Export}" Style="{StaticResource Section}" />
                        <Button Content="{l:Loc Btn_ExportText}" HorizontalAlignment="Left" Click="ExportText_Click" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18" Text="{l:Loc Hint_Export}" />

                        <TextBlock Text="{l:Loc Sec_AutoBackup}" Style="{StaticResource Section}" />
                        <CheckBox x:Name="AutoBackupCheck" Content="{l:Loc Chk_AutoBackup}" />
                        <TextBlock x:Name="AutoBackupInfo" Style="{StaticResource Hint}" Margin="20,4,0,8" />
                        <Button Content="{l:Loc Btn_OpenBackupFolder}" HorizontalAlignment="Left" Click="OpenBackupFolder_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ HAKKINDA ============ -->
            <TabItem x:Name="AboutTab" Header="{l:Loc Tab_About}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="Assets/ClipStack.ico" Width="48" Height="48" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ClipStack" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="AboutVersion" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="{l:Loc About_Description}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource StatLabel}" Text="{l:Loc About_Hotkey}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="AboutHotkey" />
                        <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="{l:Loc About_Runtime}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="AboutRuntime" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="{l:Loc About_DataFolder}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" x:Name="AboutDataFolder" TextWrapping="Wrap" />
                    </Grid>

                    <Button Content="{l:Loc Btn_OpenDataFolder}" HorizontalAlignment="Left" Click="OpenDataFolder_Click" />

                    <TextBlock Text="{l:Loc Sec_License}" Style="{StaticResource Section}" Margin="0,18,0,6" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{l:Loc About_License}" />
                    <WrapPanel>
                        <Button Content="{l:Loc Btn_License}" Margin="0,0,6,6" Click="OpenLicense_Click" />
                        <Button Content="{l:Loc Btn_Notices}" Margin="0,0,6,6" Click="OpenNotices_Click" />
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Loc Btn_Ok}" IsDefault="True" Margin="0,0,6,0" Click="Ok_Click" />
            <Button Content="{l:Loc Btn_Cancel}" IsCancel="True" Margin="0,0,6,0" Click="Cancel_Click" />
            <Button Content="{l:Loc Btn_Apply}" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
